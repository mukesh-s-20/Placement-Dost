      "examples": "Input: root = [6,2,8,0,4,7,9], p = 2, q = 8 -> Output: 6",
      "testCases": [
        {
          "input": "root = [6,2,8], p = 2, q = 8",
          "expected": "6"
        }
      ]
    },
